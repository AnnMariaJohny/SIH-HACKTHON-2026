{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "other",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "bakend": {
      "root": "sih-backend-main/sih-backend-main/bakend",
      "framework": "flask",
      "entrypoint": "app:app"
    },
    "sih_backend-main": {
      "root": "anzil/sih_backend-main/backend",
      "framework": "flask",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/ships",
      "destination": { "service": "sih_backend-main" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/geocode",
      "destination": { "service": "bakend" }
    },
    {
      "source": "/nearby-industries",
      "destination": { "service": "bakend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}